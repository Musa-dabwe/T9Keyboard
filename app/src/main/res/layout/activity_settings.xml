<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/settings_background"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/settings_root_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- HEADER AREA -->
        <LinearLayout
            android:id="@+id/header_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- Top Nav Row -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingTop="21dp">

                <ImageView
                    android:id="@+id/btn_back"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentStart="true"
                    android:padding="12dp"
                    android:src="@drawable/ic_back"
                    app:tint="@color/settings_text_primary" />

                <ImageView
                    android:id="@+id/btn_info"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentEnd="true"
                    android:padding="12dp"
                    android:src="@drawable/ic_info"
                    app:tint="@color/settings_text_primary" />
            </RelativeLayout>

            <!-- Title Row -->
            <TextView
                android:id="@+id/txt_welcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Welcome to T9\nKeyboard"
                android:textColor="@color/settings_text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp">

                <!-- TYPING -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/settings_card_background"
                    app:cardCornerRadius="12dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:id="@+id/header_typing"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:text="Typing"
                            android:textColor="@color/accent_blue"
                            android:textSize="14sp" />

                        <!-- Autocorrect -->
                        <RelativeLayout
                            android:id="@+id/row_autocorrect"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="20dp"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true">
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_alignParentStart="true"
                                android:layout_toStartOf="@id/toggle_autocorrect">
                                <TextView
                                    android:id="@+id/txt_autocorrect_title"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Autocorrect"
                                    android:textColor="@color/settings_text_primary"
                                    android:textSize="16sp" />
                                <TextView
                                    android:id="@+id/txt_autocorrect_subtitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Automatically correct words in XT9 mode"
                                    android:textColor="@color/settings_text_secondary"
                                    android:textSize="13sp" />
                            </LinearLayout>
                            <ImageView
                                android:id="@+id/toggle_autocorrect"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:src="@drawable/ic_toggle_off" />
                        </RelativeLayout>

                        <!-- Autocorrect Sensitivity -->
                        <RelativeLayout
                            android:id="@+id/row_autocorrect_sensitivity"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true">
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <TextView
                                    android:id="@+id/txt_autocorrect_sensitivity_title"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Autocorrect Sensitivity"
                                    android:textColor="@color/settings_text_primary"
                                    android:textSize="16sp" />
                                <TextView
                                    android:id="@+id/txt_autocorrect_sensitivity_subtitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Conservative / Normal / Aggressive"
                                    android:textColor="@color/settings_text_secondary"
                                    android:textSize="13sp" />
                            </LinearLayout>
                            <TextView
                                android:id="@+id/box_autocorrect_sensitivity"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:background="@drawable/value_box_background"
                                android:minWidth="36dp"
                                android:gravity="center"
                                android:padding="4dp"
                                android:text="Normal"
                                android:textColor="@color/settings_text_secondary"
                                android:textSize="14sp" />
                        </RelativeLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- INPUT MODE -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/settings_card_background"
                    app:cardCornerRadius="12dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:id="@+id/header_input_mode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:text="Input Mode"
                            android:textColor="@color/accent_blue"
                            android:textSize="14sp" />

                        <RelativeLayout
                            android:id="@+id/row_xt9"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true">
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_alignParentStart="true"
                                android:layout_toStartOf="@id/toggle_xt9">
                                <TextView
                                    android:id="@+id/txt_xt9_title"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="XT9 Predictive Text"
                                    android:textColor="@color/settings_text_primary"
                                    android:textSize="16sp" />
                                <TextView
                                    android:id="@+id/txt_xt9_subtitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="tap each key once - keyboard predicts the word"
                                    android:textColor="@color/settings_text_secondary"
                                    android:textSize="13sp" />
                            </LinearLayout>
                            <ImageView
                                android:id="@+id/toggle_xt9"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:src="@drawable/ic_toggle_off" />
                        </RelativeLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- FEEDBACK & SOUND -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/settings_card_background"
                    app:cardCornerRadius="12dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:id="@+id/header_feedback"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:text="Feedback &amp; Sound"
                            android:textColor="@color/accent_blue"
                            android:textSize="14sp" />

                        <!-- Haptic Feedback -->
                        <RelativeLayout
                            android:id="@+id/row_haptic"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="20dp"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true">
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <TextView
                                    android:id="@+id/txt_haptic_title"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Haptic Feedback"
                                    android:textColor="@color/settings_text_primary"
                                    android:textSize="16sp" />
                                <TextView
                                    android:id="@+id/txt_haptic_subtitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="vibrate on key press"
                                    android:textColor="@color/settings_text_secondary"
                                    android:textSize="13sp" />
                            </LinearLayout>
                            <ImageView
                                android:id="@+id/toggle_haptic"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:src="@drawable/ic_toggle_off" />
                        </RelativeLayout>

                        <!-- Haptic Intensity -->
                        <RelativeLayout
                            android:id="@+id/row_haptic_intensity"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="20dp"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true">
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <TextView
                                    android:id="@+id/txt_haptic_intensity_title"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Haptic Intensity (ms)"
                                    android:textColor="@color/settings_text_primary"
                                    android:textSize="16sp" />
                                <TextView
                                    android:id="@+id/txt_haptic_intensity_subtitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0-50 ms"
                                    android:textColor="@color/settings_text_secondary"
                                    android:textSize="13sp" />
                            </LinearLayout>
                            <TextView
                                android:id="@+id/box_haptic_intensity"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:background="@drawable/value_box_background"
                                android:minWidth="36dp"
                                android:gravity="center"
                                android:padding="4dp"
                                android:text="30"
                                android:textColor="@color/settings_text_secondary"
                                android:textSize="14sp" />
                        </RelativeLayout>

                        <!-- Delete Speed -->
                        <RelativeLayout
                            android:id="@+id/row_delete_speed"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="20dp"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true">
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <TextView
                                    android:id="@+id/txt_delete_speed_title"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Delete Speed"
                                    android:textColor="@color/settings_text_primary"
                                    android:textSize="16sp" />
                                <TextView
                                    android:id="@+id/txt_delete_speed_subtitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0-100 ms"
                                    android:textColor="@color/settings_text_secondary"
                                    android:textSize="13sp" />
                            </LinearLayout>
                            <TextView
                                android:id="@+id/box_delete_speed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:background="@drawable/value_box_background"
                                android:minWidth="36dp"
                                android:gravity="center"
                                android:padding="4dp"
                                android:text="100"
                                android:textColor="@color/settings_text_secondary"
                                android:textSize="14sp" />
                        </RelativeLayout>

                        <!-- Key Press Sound -->
                        <RelativeLayout
                            android:id="@+id/row_sound"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="20dp"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true">
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <TextView
                                    android:id="@+id/txt_sound_title"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Key Press Sound"
                                    android:textColor="@color/settings_text_primary"
                                    android:textSize="16sp" />
                                <TextView
                                    android:id="@+id/txt_sound_subtitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Play sound when typing"
                                    android:textColor="@color/settings_text_secondary"
                                    android:textSize="13sp" />
                            </LinearLayout>
                            <ImageView
                                android:id="@+id/toggle_sound"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:src="@drawable/ic_toggle_off" />
                        </RelativeLayout>

                        <!-- Sound Volume -->
                        <RelativeLayout
                            android:id="@+id/row_sound_volume"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true">
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <TextView
                                    android:id="@+id/txt_sound_volume_title"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Sound Volume"
                                    android:textColor="@color/settings_text_primary"
                                    android:textSize="16sp" />
                                <TextView
                                    android:id="@+id/txt_sound_volume_subtitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0-100"
                                    android:textColor="@color/settings_text_secondary"
                                    android:textSize="13sp" />
                            </LinearLayout>
                            <TextView
                                android:id="@+id/box_sound_volume"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:background="@drawable/value_box_background"
                                android:minWidth="36dp"
                                android:gravity="center"
                                android:padding="4dp"
                                android:text="50"
                                android:textColor="@color/settings_text_secondary"
                                android:textSize="14sp" />
                        </RelativeLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- EMOJI -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/settings_card_background"
                    app:cardCornerRadius="12dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:id="@+id/header_emoji"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:text="Emoji"
                            android:textColor="@color/accent_blue"
                            android:textSize="14sp" />

                        <!-- Emoji Size -->
                        <RelativeLayout
                            android:id="@+id/row_emoji_size"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true">
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <TextView
                                    android:id="@+id/txt_emoji_size_title"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Emoji Size"
                                    android:textColor="@color/settings_text_primary"
                                    android:textSize="16sp" />
                                <TextView
                                    android:id="@+id/txt_emoji_size_subtitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="16-40 sp"
                                    android:textColor="@color/settings_text_secondary"
                                    android:textSize="13sp" />
                            </LinearLayout>
                            <TextView
                                android:id="@+id/box_emoji_size"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:background="@drawable/value_box_background"
                                android:minWidth="36dp"
                                android:gravity="center"
                                android:padding="4dp"
                                android:text="32"
                                android:textColor="@color/settings_text_secondary"
                                android:textSize="14sp" />
                        </RelativeLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- LAYOUT & SIZING -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/settings_card_background"
                    app:cardCornerRadius="12dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:id="@+id/header_layout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:text="Layout &amp; Sizing"
                            android:textColor="@color/accent_blue"
                            android:textSize="14sp" />

                        <!-- Multi-tap Timeout -->
                        <RelativeLayout
                            android:id="@+id/row_timeout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="20dp"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true">
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <TextView
                                    android:id="@+id/txt_timeout_title"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Multi-tap timeout"
                                    android:textColor="@color/settings_text_primary"
                                    android:textSize="16sp" />
                                <TextView
                                    android:id="@+id/txt_timeout_subtitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0-800 ms"
                                    android:textColor="@color/settings_text_secondary"
                                    android:textSize="13sp" />
                            </LinearLayout>
                            <TextView
                                android:id="@+id/box_timeout"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:background="@drawable/value_box_background"
                                android:minWidth="36dp"
                                android:gravity="center"
                                android:padding="4dp"
                                android:text="800"
                                android:textColor="@color/settings_text_secondary"
                                android:textSize="14sp" />
                        </RelativeLayout>

                        <!-- Key label font size -->
                        <RelativeLayout
                            android:id="@+id/row_key_font"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="20dp"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true">
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <TextView
                                    android:id="@+id/txt_key_font_title"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Key label font size"
                                    android:textColor="@color/settings_text_primary"
                                    android:textSize="16sp" />
                                <TextView
                                    android:id="@+id/txt_key_font_subtitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0-40 sp"
                                    android:textColor="@color/settings_text_secondary"
                                    android:textSize="13sp" />
                            </LinearLayout>
                            <TextView
                                android:id="@+id/box_key_font"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:background="@drawable/value_box_background"
                                android:minWidth="36dp"
                                android:gravity="center"
                                android:padding="4dp"
                                android:text="25"
                                android:textColor="@color/settings_text_secondary"
                                android:textSize="14sp" />
                        </RelativeLayout>

                        <!-- Suggestion font size -->
                        <RelativeLayout
                            android:id="@+id/row_suggestion_font"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true">
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <TextView
                                    android:id="@+id/txt_suggestion_font_title"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Suggestion Font Size"
                                    android:textColor="@color/settings_text_primary"
                                    android:textSize="16sp" />
                                <TextView
                                    android:id="@+id/txt_suggestion_font_subtitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0-30 sp"
                                    android:textColor="@color/settings_text_secondary"
                                    android:textSize="13sp" />
                            </LinearLayout>
                            <TextView
                                android:id="@+id/box_suggestion_font"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:background="@drawable/value_box_background"
                                android:minWidth="36dp"
                                android:gravity="center"
                                android:padding="4dp"
                                android:text="15"
                                android:textColor="@color/settings_text_secondary"
                                android:textSize="14sp" />
                        </RelativeLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- THEME -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/settings_card_background"
                    app:cardCornerRadius="12dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:id="@+id/header_theme"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:text="Theme"
                            android:textColor="@color/accent_blue"
                            android:textSize="14sp" />

                        <!-- Accent Color -->
                        <TextView
                            android:id="@+id/txt_accent_color_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:text="Accent color"
                            android:textColor="@color/settings_text_primary"
                            android:textSize="16sp" />

                        <LinearLayout
                            android:id="@+id/accent_colors_layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="24dp"
                            android:gravity="center_vertical" />

                        <!-- Theme Selection -->
                        <TextView
                            android:id="@+id/txt_theme_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Theme"
                            android:textColor="@color/settings_text_primary"
                            android:textSize="16sp" />

                        <LinearLayout
                            android:id="@+id/spinner_theme"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical">
                            <TextView
                                android:id="@+id/txt_selected_theme"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Dark"
                                android:textColor="@color/settings_text_secondary"
                                android:textSize="14sp" />
                            <ImageView
                                android:id="@+id/img_dropdown"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_moon"
                                android:rotation="180"
                                app:tint="@color/settings_text_secondary"
                                android:visibility="gone" /> <!-- Just a placeholder if I need an arrow -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=" ▼"
                                android:textColor="@color/settings_text_secondary"
                                android:textSize="10sp" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- INTEGRATIONS -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/settings_card_background"
                    app:cardCornerRadius="12dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:id="@+id/header_integrations"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:text="Integrations"
                            android:textColor="@color/accent_blue"
                            android:textSize="14sp" />

                        <!-- Contact Suggestions -->
                        <RelativeLayout
                            android:id="@+id/row_contacts"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true">
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_alignParentStart="true"
                                android:layout_toStartOf="@id/toggle_contacts">
                                <TextView
                                    android:id="@+id/txt_contacts_title"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Contact Suggestions"
                                    android:textColor="@color/settings_text_primary"
                                    android:textSize="16sp" />
                                <TextView
                                    android:id="@+id/txt_contacts_subtitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Suggest contact names while typing"
                                    android:textColor="@color/settings_text_secondary"
                                    android:textSize="13sp" />
                            </LinearLayout>
                            <ImageView
                                android:id="@+id/toggle_contacts"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:src="@drawable/ic_toggle_off" />
                        </RelativeLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- DICTIONARY -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_clear_dict"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:text="Clear learned dictionary"
                    android:textAllCaps="false"
                    android:textColor="@color/settings_text_primary"
                    android:textSize="16sp"
                    app:cornerRadius="32dp"
                    app:icon="@drawable/ic_delete"
                    app:iconGravity="textStart"
                    app:iconPadding="12dp"
                    app:iconSize="24dp"
                    app:iconTint="@color/settings_text_primary"
                    app:strokeColor="@color/accent_purple" />

                <TextView
                    android:id="@+id/txt_clear_dict_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="This will delete all custom words and predictions learned by the keyboard."
                    android:textColor="@color/settings_text_secondary"
                    android:textSize="13sp" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
