<?xml version="1.0" encoding="utf-8"?>
<com.musa.t9keyboard.EmojiSearchPanelView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/emojiSearchPanel"
    android:layout_width="match_parent"
    android:layout_height="304dp"
    android:orientation="vertical"
    android:background="#292929">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/emoji_search_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#3A3A3A">

        <!-- Results row -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/emoji_search_results"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            android:scrollbars="none"
            android:visibility="gone" />

        <!-- Query area -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/emoji_search_query_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="8dp"
                android:paddingBottom="4dp"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                android:hint="Search emoji…"
                android:textColorHint="#888888" />

            <View
                android:id="@+id/emoji_search_underline"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="#E91E63" />
        </LinearLayout>
    </LinearLayout>

    <!-- QWERTY Keyboard Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="4dp">

        <!-- Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center">
            <TextView android:id="@+id/key_q" style="@style/EmojiSearchKey" android:text="Q" />
            <TextView android:id="@+id/key_w" style="@style/EmojiSearchKey" android:text="W" />
            <TextView android:id="@+id/key_e" style="@style/EmojiSearchKey" android:text="E" />
            <TextView android:id="@+id/key_r" style="@style/EmojiSearchKey" android:text="R" />
            <TextView android:id="@+id/key_t" style="@style/EmojiSearchKey" android:text="T" />
            <TextView android:id="@+id/key_y" style="@style/EmojiSearchKey" android:text="Y" />
            <TextView android:id="@+id/key_u" style="@style/EmojiSearchKey" android:text="U" />
            <TextView android:id="@+id/key_i" style="@style/EmojiSearchKey" android:text="I" />
            <TextView android:id="@+id/key_o" style="@style/EmojiSearchKey" android:text="O" />
            <TextView android:id="@+id/key_p" style="@style/EmojiSearchKey" android:text="P" />
        </LinearLayout>

        <!-- Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">
            <TextView android:id="@+id/key_a" style="@style/EmojiSearchKey" android:text="A" />
            <TextView android:id="@+id/key_s" style="@style/EmojiSearchKey" android:text="S" />
            <TextView android:id="@+id/key_d" style="@style/EmojiSearchKey" android:text="D" />
            <TextView android:id="@+id/key_f" style="@style/EmojiSearchKey" android:text="F" />
            <TextView android:id="@+id/key_g" style="@style/EmojiSearchKey" android:text="G" />
            <TextView android:id="@+id/key_h" style="@style/EmojiSearchKey" android:text="H" />
            <TextView android:id="@+id/key_j" style="@style/EmojiSearchKey" android:text="J" />
            <TextView android:id="@+id/key_k" style="@style/EmojiSearchKey" android:text="K" />
            <TextView android:id="@+id/key_l" style="@style/EmojiSearchKey" android:text="L" />
        </LinearLayout>

        <!-- Row 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="4dp">
            <TextView android:id="@+id/key_z" style="@style/EmojiSearchKey" android:text="Z" />
            <TextView android:id="@+id/key_x" style="@style/EmojiSearchKey" android:text="X" />
            <TextView android:id="@+id/key_c" style="@style/EmojiSearchKey" android:text="C" />
            <TextView android:id="@+id/key_v" style="@style/EmojiSearchKey" android:text="V" />
            <TextView android:id="@+id/key_b" style="@style/EmojiSearchKey" android:text="B" />
            <TextView android:id="@+id/key_n" style="@style/EmojiSearchKey" android:text="N" />
            <TextView android:id="@+id/key_m" style="@style/EmojiSearchKey" android:text="M" />

            <ImageButton
                android:id="@+id/emoji_search_delete"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.5"
                android:layout_margin="3dp"
                android:background="@drawable/emoji_search_key_bg"
                app:srcCompat="@drawable/ic_backspace"
                android:scaleType="centerInside"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

</com.musa.t9keyboard.EmojiSearchPanelView>
