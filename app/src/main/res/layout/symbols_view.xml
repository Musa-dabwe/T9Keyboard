<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="304dp"
    android:orientation="vertical"
    android:background="@color/keyboard_background">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/symbol_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:scrollbars="none" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="@color/abc_button_background">

        <Button
            android:id="@+id/btn_back_to_abc"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:text="ABC"
            android:background="@android:color/transparent"
            android:textColor="@color/key_text_color"
            android:textSize="18sp"
            android:textStyle="bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:textAllCaps="true" />

        <FrameLayout
            android:id="@+id/btn_symbol_delete"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent">
            <ImageView
                android:id="@+id/btnSymbolDeleteIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_delete"
                app:tint="@color/delete_key_color" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
