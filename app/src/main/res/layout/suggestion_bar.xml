<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:background="@color/suggestion_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/suggestion_raw"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="#888888"
            android:textSize="18sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />

        <View
            android:id="@+id/divider_raw"
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:background="#555555"
            android:visibility="gone" />

        <TextView
            android:id="@+id/suggestion1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/suggestion_text_color"
            android:textSize="27sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:background="#555555" />

        <TextView
            android:id="@+id/suggestion2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/suggestion_text_color"
            android:textSize="27sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:background="#555555" />

        <TextView
            android:id="@+id/suggestion3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/suggestion_text_color"
            android:textSize="27sp"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

    <TextView
        android:id="@+id/xt9_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="XT9"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="@color/accent_purple"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="4dp"
        android:visibility="gone" />

</FrameLayout>
