<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/emoji_search_container"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:layout_marginHorizontal="8dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/emoji_search_container_bg">

    <HorizontalScrollView
        android:id="@+id/emoji_search_results_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/emoji_search_results_row"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

    </HorizontalScrollView>

    <View
        android:id="@+id/emoji_search_divider"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="0dp"
        android:background="@drawable/emoji_search_divider" />

</FrameLayout>
