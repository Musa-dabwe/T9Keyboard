<?xml version="1.0" encoding="utf-8"?>
<!--
    The emoji picker is fully programmatic via EmojiPickerView.kt.
    This layout simply hosts the view as the root element.
    Height is controlled by the keyboard container.
-->
<com.musa.t9keyboard.EmojiPickerView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/emojiPickerView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical" />
