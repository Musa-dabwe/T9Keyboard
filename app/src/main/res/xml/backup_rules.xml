<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Exclude learned words - contains user typing history -->
    <exclude domain="sharedpref" path="learned_words.xml" />
    <!-- Exclude preferences - contains sensitive toggles -->
    <exclude domain="sharedpref" path="t9_prefs.xml" />
    <!-- Include other app data if needed -->
    <include domain="database" path="." />
</full-backup-content>
